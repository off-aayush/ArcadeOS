# Copy this file to .env and replace the example values.
# Keep .env private. Prisma CLI reads DATABASE_URL from this file.

# Existing PostgreSQL database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arcadeos"

# JWT signing secret: at least 32 random characters
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Browser URL used by the Socket.IO client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
PORT="3000"
