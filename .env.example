# ─────────────────────────────────────────────────────────────
# ArcadeOS — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgresql://USER:PASSWORD@localhost:5432/arcadeos
# Supabase: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Neon:    postgresql://USER:PASSWORD@HOST/arcadeos?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arcadeos"

# ── Next.js / Auth ──────────────────────────────────────────────
AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-chars"

# ── App Config ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ArcadeOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# ── Feature Flags ─────────────────────────────────────────────
# Enable/disable membership module
NEXT_PUBLIC_MEMBERSHIP_ENABLED="true"
# Enable/disable food & drinks module
NEXT_PUBLIC_FOOD_MODULE_ENABLED="true"
